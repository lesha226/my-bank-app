{
  "realm": "bank-realm",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Regular bank user",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "TRANSFER_WRITE",
        "description": "Permission to perform transfers",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CASH_WRITE",
        "description": "Permission to perform cash operations",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "NOTIFICATION_WRITE",
        "description": "Permission to perform notification operations",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "SERVICE",
        "description": "Generic service role for microservices",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ACCOUNTS_WRITE",
        "description": "Permission to write to accounts",
        "composite": false,
        "clientRole": false
      }
    ]
  },

  "clients": [
    {
      "clientId": "front-ui",
      "name": "Bank UI",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "front-ui-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/*"
      ],
      "baseUrl": "http://localhost:8080",
      "webOrigins": [
        "http://localhost:8080"
      ],
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "transfer-service",
      "name": "Transfer Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "transfer-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "cash-service",
      "name": "Cash Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "cash-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "notification-service",
      "name": "Notification Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "notification-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "accounts-service",
      "name": "accounts Service",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "accounts-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],

  "users": [
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "user@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ACCOUNTS_WRITE",
        "TRANSFER_WRITE",
        "CASH_WRITE"
      ]
    },
    {
      "username": "user2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User2",
      "email": "user2@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "user2",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ACCOUNTS_WRITE",
        "TRANSFER_WRITE",
        "CASH_WRITE"
      ]
    },
    {
      "username": "user3",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User3",
      "email": "user3@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "user3",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ACCOUNTS_WRITE",
        "TRANSFER_WRITE",
        "CASH_WRITE"
      ]
    },
    {
      "username": "service-account-transfer-service",
      "enabled": true,
      "serviceAccountClientId": "transfer-service",
      "realmRoles": [
        "SERVICE",
        "ACCOUNTS_WRITE",
        "NOTIFICATION_WRITE"
      ]
    },
    {
      "username": "service-account-cash-service",
      "enabled": true,
      "serviceAccountClientId": "cash-service",
      "realmRoles": [
        "SERVICE",
        "ACCOUNTS_WRITE",
        "NOTIFICATION_WRITE"
      ]
    },
    {
      "username": "service-notification-account-service",
      "enabled": true,
      "serviceAccountClientId": "accounts-service",
      "realmRoles": [
        "SERVICE",
        "NOTIFICATION_WRITE"
      ]
    }
  ]
}
